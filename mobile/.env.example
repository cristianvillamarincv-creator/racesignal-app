# Copy the files you need (they are gitignored) and fill in values. NEVER commit real values.
# Environments are separate and explicit:
#
#   .env.development   -> used by `npm run start:dev` / `start:go` (APP_VARIANT=development)
#       EXPO_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co      # the racesignal-dev project ONLY
#       EXPO_PUBLIC_SUPABASE_ANON_KEY=<dev anon key>
#       EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=test_...                         # RevenueCat dev project Test Store key
#       EXPO_PUBLIC_ENABLE_DEV_PREVIEW=true                                 # local-only Developer Preview switch
#
#   .env.production    -> only for local NODE_ENV=production runs (EAS release builds use the EAS "production"
#                         environment instead and never read this file)
#       EXPO_PUBLIC_SUPABASE_URL=...  EXPO_PUBLIC_SUPABASE_ANON_KEY=...
#
# app.config.js refuses to start if the variant, Supabase URL, and RevenueCat key don't match each other.
# Keep this shared .env free of backend settings.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
